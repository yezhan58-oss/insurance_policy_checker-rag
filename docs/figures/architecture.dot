// Render: dot -Tpng -Gdpi=200 architecture.dot -o architecture.png
digraph G {
  rankdir=LR; nodesep=0.25; ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#f2f2f2", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  pdf   [label="Policy PDFs\n(FWD, MSIG)"];
  ingest[label="ingest.py\nsplit by headings → sections\nwith IDs → chunks"];
  index [label="Chroma index\nbge-small-en-v1.5 (CPU)\n+ defined-terms lookup", shape=cylinder];
  scen  [label="Claim scenario\n(124 test, 20 dev)"];

  subgraph cluster_setups {
    label="Setups (same model, index and base prompt)"; fontname="Helvetica"; fontsize=11; style="rounded"; color="#999999";
    B0 [label="B0  no retrieval"];
    A0 [label="A0  simple RAG\nsearch top 5"];
    A2 [label="A2  corrective RAG\nsearch → grade chunks →\nrewrite query (max 2)"];
    A4 [label="A4  claims workflow\nbenefit → definitions →\nexclusions → decide"];
    L0 [label="L0  long context\nwhole policy (exploratory)"];
  }

  llm   [label="LLM on vLLM (SMU cluster)\nLlama 3.1 8B | gpt-oss-20b"];
  out   [label="VerdictOutput\nverdict, cited sections,\nexplanation, steps, usage"];
  score [label="Scoring\naccuracy, wrong-covered, clause recall,\nbootstrap CI, McNemar (Holm),\ntrace metrics"];
  judge [label="Haiku 5.5 judge\nfaithfulness"];
  demo  [label="Streamlit demo\n(winner A0, A4 toggle)"];

  pdf -> ingest -> index;
  scen -> {B0 A0 A2 A4 L0};
  index -> {A0 A2 A4} [label="search / get_section"];
  index -> L0 [style=dashed, label="every section, in order"];
  {B0 A0 A2 A4 L0} -> llm [dir=both];
  llm -> out;
  out -> score; out -> judge -> score;
  score -> demo [label="decision rule"];
}
